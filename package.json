{
  "name": "esp32-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:seed": "node scripts/build-seed.ts",
    "db:migrate:local": "wrangler d1 migrations apply esp32-atlas-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply esp32-atlas-db --remote",
    "fetch:github": "node scripts/fetch-github.ts",
    "admin:create": "node scripts/create-admin.ts",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "lucide-react": "0.545.0",
    "next": "^15.5.28",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "dugite": "^3.3.1",
    "eslint": "9.38.0",
    "eslint-config-next": "15.5.7",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.1.14": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "dugite@3.3.1": true,
    "workerd@1.20261019.1": true
  }
}
